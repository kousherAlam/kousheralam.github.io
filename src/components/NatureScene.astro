---
// An ambient, painterly evening scene behind the whole site: twilight sky with a
// dusk glow, a moon, stars, a distant village with lamp-lit windows, a shimmering
// lake with reflections, a mud road, a swaying tree, fireflies, birds, and rain.
// Sits behind content (pointer-events: none); calms right down under reduced motion.
let seed = 20260726;
const rnd = () => {
  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
  return seed / 0x7fffffff;
};

const stars = Array.from({ length: 60 }, () => ({
  x: (rnd() * 100).toFixed(2),
  y: (rnd() * 42).toFixed(2),
  r: (0.4 + rnd() * 1.1).toFixed(2),
  d: (2 + rnd() * 4).toFixed(2),
  delay: (rnd() * 5).toFixed(2),
}));

const drops = Array.from({ length: 60 }, () => ({
  left: (rnd() * 100).toFixed(2),
  delay: (rnd() * 4).toFixed(2),
  dur: (0.7 + rnd() * 0.9).toFixed(2),
  len: (34 + rnd() * 60).toFixed(0),
  op: (0.06 + rnd() * 0.18).toFixed(2),
}));

const fireflies = Array.from({ length: 16 }, () => ({
  x: (rnd() * 100).toFixed(2),
  y: (55 + rnd() * 38).toFixed(2),
  d: (5 + rnd() * 6).toFixed(2),
  delay: (rnd() * 8).toFixed(2),
  dx: (rnd() * 40 - 20).toFixed(0),
  dy: (-15 - rnd() * 25).toFixed(0),
}));

const birds = Array.from({ length: 4 }, (_, i) => ({
  top: (8 + rnd() * 22).toFixed(1),
  size: (15 + rnd() * 14).toFixed(0),
  dur: (18 + rnd() * 14).toFixed(1),
  delay: (i * 6 + rnd() * 6).toFixed(1),
  flap: (0.4 + rnd() * 0.22).toFixed(2),
  drift: (2 + rnd() * 4).toFixed(1),
}));

const leaves = Array.from({ length: 5 }, () => ({
  delay: (rnd() * 12).toFixed(1),
  dur: (9 + rnd() * 7).toFixed(1),
  sway: (20 + rnd() * 40).toFixed(0),
}));

// Bangladeshi village tin-roof huts on the far bank (viewBox window 0 58 1440 242):
// [x, baseY, w, h, roofH, warm-lamp?] — low, wide, shallow-pitched roofs.
const houses = [
  [150, 92, 52, 21, 7, true],
  [216, 93, 40, 17, 6, false],
  [286, 91, 62, 24, 8, true],
  [360, 93, 44, 18, 6, true],
  [412, 92, 50, 21, 7, false],
  [980, 92, 54, 22, 8, true],
  [1046, 93, 40, 17, 6, false],
  [1096, 91, 60, 24, 8, true],
  [1166, 92, 46, 19, 7, true],
];

// Coconut palms along the far bank: [x, baseY, scale, warm-lamp-at-base?]
const palms = [
  [116, 93, 0.9],
  [204, 92, 1.15],
  [340, 93, 0.8],
  [470, 92, 1.0],
  [946, 93, 0.95],
  [1140, 92, 1.1],
  [1244, 93, 0.85],
];

// Rain ripples on the pond surface
const ripples = Array.from({ length: 10 }, () => ({
  x: (rnd() * 100).toFixed(1),
  y: (60 + rnd() * 30).toFixed(1),
  d: (2.6 + rnd() * 2.4).toFixed(2),
  delay: (rnd() * 6).toFixed(2),
  s: (10 + rnd() * 16).toFixed(0),
}));

// Lily pads floating on the pond: [x%, y%, w, tilt, lotus?]
const pads = [
  [16, 76, 30, -8, true],
  [30, 84, 24, 6, false],
  [46, 79, 34, 0, false],
  [62, 86, 22, 10, true],
  [76, 80, 28, -6, false],
  [88, 85, 20, 4, false],
];
---

<div class="scene" aria-hidden="true">
  <div class="sky"></div>
  <div class="dusk"></div>

  <div class="moon"></div>

  <div class="stars">
    {
      stars.map((s) => (
        <span
          class="star"
          style={`left:${s.x}%;top:${s.y}%;width:${s.r}px;height:${s.r}px;animation-duration:${s.d}s;animation-delay:${s.delay}s`}
        />
      ))
    }
  </div>

  <!-- Landscape: Bangladeshi village with coconut palms, tin huts, and a pond -->
  <svg class="landscape" viewBox="0 58 1440 242" preserveAspectRatio="xMidYMax slice">
    <defs>
      <linearGradient id="pond" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#5b3a3d" />
        <stop offset="0.16" stop-color="#3a2a44" />
        <stop offset="0.5" stop-color="#171634" />
        <stop offset="1" stop-color="#080a1e" />
      </linearGradient>
      <linearGradient id="reflect" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#ffc06a" stop-opacity="0.6" />
        <stop offset="1" stop-color="#ffc06a" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="moonrefl" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f2e9d8" stop-opacity="0.45" />
        <stop offset="1" stop-color="#f2e9d8" stop-opacity="0" />
      </linearGradient>
      <filter id="soft" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="1.5" />
      </filter>
      <!-- one coconut palm, reused -->
      <g id="palm">
        <path d="M-2 0 C -3 -34 -2 -60 0 -86 C 2 -60 3 -34 2 0 Z" fill="#0c1026" />
        <g stroke="#0c1026" stroke-width="3.2" stroke-linecap="round" fill="none">
          <path d="M0 -86 Q -20 -104 -46 -96" />
          <path d="M0 -86 Q 20 -104 46 -96" />
          <path d="M0 -86 Q -30 -92 -54 -78" />
          <path d="M0 -86 Q 30 -92 54 -78" />
          <path d="M0 -86 Q -14 -108 -24 -116" />
          <path d="M0 -86 Q 14 -108 24 -116" />
          <path d="M0 -86 Q 0 -112 3 -120" />
        </g>
      </g>
    </defs>

    <!-- far tree line -->
    <path d="M0 92 Q 90 70 190 86 Q 300 66 430 84 Q 560 70 700 86 Q 860 68 1010 84 Q 1180 68 1320 84 Q 1400 78 1440 84 V 100 H0 Z" fill="#0c1230" />
    <path d="M0 94 Q 140 80 300 92 Q 520 78 760 92 Q 1000 80 1240 92 Q 1360 86 1440 92 V 104 H0 Z" fill="#0a0f28" opacity="0.9" />

    <!-- coconut palms -->
    <g class="palms">
      {
        palms.map(([x, baseY, s]) => (
          <use href="#palm" transform={`translate(${x} ${baseY}) scale(${s})`} />
        ))
      }
    </g>

    <!-- tin-roof huts -->
    <g class="village">
      {
        houses.map(([x, baseY, w, h, rh, warm]) => {
          const wallH = h - rh;
          const wallTop = baseY - wallH;
          const apexY = baseY - h;
          return (
            <g>
              <polygon points={`${x - 9},${wallTop} ${x + w / 2},${apexY} ${x + w + 9},${wallTop}`} fill="#0a0e24" />
              <rect x={x} y={wallTop} width={w} height={wallH} fill="#0e1230" />
              {warm && (
                <>
                  <rect x={x + w * 0.22} y={wallTop + 4} width="4.5" height="5" class="win" fill="#ffcf7a" filter="url(#soft)" />
                  <rect x={x + w * 0.62} y={wallTop + 4} width="4.5" height="5" class="win win-b" fill="#ffbf68" filter="url(#soft)" />
                </>
              )}
            </g>
          );
        })
      }
    </g>

    <!-- pond -->
    <rect x="0" y="92" width="1440" height="208" fill="url(#pond)" />
    <!-- mirrored tree-line reflection just below the water's edge -->
    <rect x="0" y="92" width="1440" height="18" fill="#0a0f28" opacity="0.5" />

    <g class="reflections">
      <rect x="176" y="96" width="6" height="60" fill="url(#reflect)" />
      <rect x="312" y="96" width="7" height="66" fill="url(#reflect)" />
      <rect x="386" y="96" width="6" height="56" fill="url(#reflect)" />
      <rect x="1006" y="96" width="7" height="66" fill="url(#reflect)" />
      <rect x="1122" y="96" width="7" height="70" fill="url(#reflect)" />
      <rect x="1192" y="96" width="6" height="58" fill="url(#reflect)" />
      <rect x="1150" y="96" width="18" height="120" fill="url(#moonrefl)" />
    </g>

    <!-- a country boat on the pond, with a small lamp -->
    <g class="boat">
      <path d="M596 150 Q 660 138 742 150 Q 690 166 646 165 Q 616 162 596 150 Z" fill="#0a0d22" />
      <rect x="662" y="132" width="2.4" height="18" fill="#0a0d22" />
      <circle cx="663" cy="130" r="3.2" fill="#ffc169" filter="url(#soft)" />
    </g>

    <!-- lily pads (some with a lotus) -->
    <g class="pads" fill="#123a2c">
      <ellipse cx="210" cy="196" rx="17" ry="5" transform="rotate(-6 210 196)" />
      <ellipse cx="430" cy="210" rx="20" ry="6" />
      <circle cx="430" cy="208" r="3.2" fill="#e07a9b" />
      <ellipse cx="620" cy="200" rx="14" ry="4.5" transform="rotate(8 620 200)" />
      <ellipse cx="880" cy="212" rx="18" ry="5.5" />
      <ellipse cx="1040" cy="202" rx="15" ry="4.6" transform="rotate(-5 1040 202)" />
      <circle cx="1040" cy="200" r="3" fill="#e88bab" />
      <ellipse cx="1240" cy="208" rx="16" ry="5" />
    </g>

    <!-- foreground bank + reeds + kaccha (dirt) road -->
    <path d="M0 214 Q 380 198 760 220 T 1440 224 V 300 H0 Z" fill="#080a1a" />
    <g stroke="#0e2a1e" stroke-width="2.2" stroke-linecap="round" class="reeds">
      <path d="M70 224 Q 66 206 72 192" />
      <path d="M84 224 Q 88 208 84 196" />
      <path d="M96 224 Q 92 210 98 198" />
      <path d="M1330 226 Q 1326 208 1332 194" />
      <path d="M1346 226 Q 1350 210 1346 198" />
      <path d="M1358 226 Q 1354 212 1360 200" />
    </g>
    <path d="M690 300 Q 664 268 632 240 Q 610 220 616 210 Q 700 220 780 210 Q 786 224 762 242 Q 730 270 748 300 Z" fill="#40301f" opacity="0.92" />
    <path d="M700 300 Q 680 270 656 244 Q 700 240 742 244 Q 724 272 738 300 Z" fill="#523c26" opacity="0.7" />
  </svg>

  <!-- rain ripples on the pond -->
  <div class="ripples">
    {
      ripples.map((r) => (
        <span
          class="ripple"
          style={`left:${r.x}%;top:${r.y}%;width:${r.s}px;height:${Math.round(Number(r.s) * 0.34)}px;animation-duration:${r.d}s;animation-delay:${r.delay}s`}
        />
      ))
    }
  </div>

  <!-- Fireflies -->
  <div class="fireflies">
    {
      fireflies.map((f) => (
        <span
          class="firefly"
          style={`left:${f.x}%;top:${f.y}%;animation-duration:${f.d}s;animation-delay:${f.delay}s;--dx:${f.dx}px;--dy:${f.dy}px`}
        />
      ))
    }
  </div>

  <!-- Tree (foreground bank) -->
  <div class="tree">
    <svg viewBox="0 0 200 240" width="200" height="240">
      <path
        class="trunk"
        d="M96 240 C94 190 92 168 90 150 C88 132 84 122 78 112 M104 240 C106 196 108 172 110 152 C112 134 118 120 126 110"
        fill="none"
      />
      <g class="foliage">
        <circle cx="100" cy="86" r="52" />
        <circle cx="64" cy="104" r="38" />
        <circle cx="138" cy="104" r="40" />
        <circle cx="100" cy="120" r="46" />
        <circle cx="82" cy="70" r="30" />
        <circle cx="124" cy="72" r="30" />
      </g>
    </svg>
    <div class="leaves">
      {
        leaves.map((l) => (
          <span
            class="leaf"
            style={`animation-delay:${l.delay}s;animation-duration:${l.dur}s;--sway:${l.sway}px`}
          />
        ))
      }
    </div>
  </div>

  <!-- Birds -->
  <div class="birds">
    {
      birds.map((b) => (
        <div
          class="bird"
          style={`top:${b.top}vh;width:${b.size}px;animation-duration:${b.dur}s;animation-delay:${b.delay}s;--drift:${b.drift}vh`}
        >
          <svg viewBox="0 0 40 20" style={`animation-duration:${b.flap}s`} class="bird-svg">
            <path class="wing wl" d="M20 11 Q11 3 2 9" />
            <path class="wing wr" d="M20 11 Q29 3 38 9" />
          </svg>
        </div>
      ))
    }
  </div>

  <!-- Rain -->
  <div class="rain">
    {
      drops.map((d) => (
        <span
          class="drop"
          style={`left:${d.left}%;animation-delay:${d.delay}s;animation-duration:${d.dur}s;height:${d.len}px;opacity:${d.op}`}
        />
      ))
    }
  </div>
</div>

<style>
  .scene {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Twilight sky + horizon dusk glow */
  .sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      #120f2e 0%,
      #1d1642 24%,
      #2c2050 40%,
      #46294f 52%,
      #6a3a49 60%,
      #97583f 67%,
      #6e4136 72%,
      #2a1c38 78%
    );
  }
  .dusk {
    position: absolute;
    left: 50%;
    bottom: 24%;
    width: 130vw;
    height: 46vh;
    transform: translateX(-50%);
    background: radial-gradient(
      ellipse at 50% 100%,
      rgb(255 176 92 / 0.42) 0%,
      rgb(238 132 74 / 0.24) 26%,
      rgb(180 92 96 / 0.12) 48%,
      transparent 72%
    );
  }
  .moon {
    position: absolute;
    top: 12%;
    right: 16%;
    width: 74px;
    height: 74px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 38%, #fff7e8, #e9dfc4 60%, #d9cba6);
    box-shadow:
      0 0 30px 10px rgb(255 244 214 / 0.28),
      0 0 80px 30px rgb(255 236 190 / 0.12);
  }

  .stars {
    position: absolute;
    inset: 0;
  }
  .star {
    position: absolute;
    border-radius: 50%;
    background: #fdf6e3;
    animation: twinkle ease-in-out infinite;
    will-change: opacity, transform;
  }
  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.25;
      transform: scale(0.8);
    }
    50% {
      opacity: 0.95;
      transform: scale(1.15);
    }
  }

  .landscape {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 55vh;
  }
  .win {
    animation: win-twinkle 4s ease-in-out infinite;
  }
  .win-b {
    animation-delay: 1.7s;
  }
  @keyframes win-twinkle {
    0%,
    100% {
      opacity: 0.85;
    }
    50% {
      opacity: 0.5;
    }
  }
  .reflections {
    animation: shimmer 6s ease-in-out infinite;
    transform-origin: center;
    will-change: transform;
  }
  @keyframes shimmer {
    0%,
    100% {
      transform: translateX(0) scaleY(1);
      opacity: 0.9;
    }
    50% {
      transform: translateX(4px) scaleY(1.04);
      opacity: 0.65;
    }
  }

  .fireflies {
    position: absolute;
    inset: 0;
  }
  .firefly {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #ffe08a;
    box-shadow: 0 0 6px 2px rgb(255 210 120 / 0.7);
    animation: float ease-in-out infinite;
    will-change: transform, opacity;
  }
  @keyframes float {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    20% {
      opacity: 0.9;
    }
    80% {
      opacity: 0.7;
    }
    100% {
      transform: translate(var(--dx), var(--dy));
      opacity: 0;
    }
  }

  /* Rain ripples on the pond */
  .ripples {
    position: absolute;
    inset: 0;
  }
  .ripple {
    position: absolute;
    border: 1px solid rgb(214 226 255 / 0.45);
    border-radius: 50%;
    transform: scale(0.2);
    opacity: 0;
    animation: ripple-expand ease-out infinite;
    will-change: transform, opacity;
  }
  @keyframes ripple-expand {
    0% {
      transform: scale(0.15);
      opacity: 0;
    }
    22% {
      opacity: 0.5;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* Rain */
  .rain {
    position: absolute;
    inset: -5% -12% 0 -12%;
    transform: rotate(9deg);
    transform-origin: top center;
  }
  .drop {
    position: absolute;
    top: -12%;
    width: 1px;
    border-radius: 1px;
    background: linear-gradient(to bottom, transparent, rgb(190 205 235 / 0.75));
    animation: rain-fall linear infinite;
    will-change: transform;
  }
  @keyframes rain-fall {
    from {
      transform: translateY(-10vh);
    }
    to {
      transform: translateY(120vh);
    }
  }

  /* Birds */
  .bird {
    position: absolute;
    left: -8%;
    animation: bird-fly linear infinite;
    will-change: transform;
  }
  @keyframes bird-fly {
    0% {
      transform: translate(-10vw, 0);
    }
    50% {
      transform: translate(52vw, calc(var(--drift) * -1));
    }
    100% {
      transform: translate(118vw, 0);
    }
  }
  .bird-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .wing {
    fill: none;
    stroke: rgb(210 218 235 / 0.5);
    stroke-width: 2.4;
    stroke-linecap: round;
    transform-origin: 20px 11px;
    animation: bird-flap ease-in-out infinite alternate;
    animation-duration: inherit;
  }
  @keyframes bird-flap {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-3px) scaleY(0.7);
    }
  }

  /* Tree */
  .tree {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 200px;
    opacity: 0.5;
  }
  .tree svg {
    display: block;
  }
  .trunk {
    stroke: rgb(96 58 36 / 0.95);
    stroke-width: 9;
    stroke-linecap: round;
  }
  .foliage circle {
    fill: rgb(14 66 48 / 0.95);
  }
  .foliage {
    transform-origin: 100px 210px;
    animation: tree-sway 7s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes tree-sway {
    0%,
    100% {
      transform: rotate(-1.6deg);
    }
    50% {
      transform: rotate(1.6deg);
    }
  }
  .leaves {
    position: absolute;
    inset: 0;
  }
  .leaf {
    position: absolute;
    top: 60px;
    left: 90px;
    width: 7px;
    height: 5px;
    border-radius: 60% 0 60% 0;
    background: rgb(34 120 84 / 0.85);
    animation: leaf-fall ease-in infinite;
    will-change: transform, opacity;
  }
  @keyframes leaf-fall {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 0.8;
    }
    90% {
      opacity: 0.5;
    }
    100% {
      transform: translate(var(--sway), 190px) rotate(220deg);
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .tree {
      width: 130px;
      opacity: 0.4;
    }
    .moon {
      width: 54px;
      height: 54px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .star,
    .win,
    .reflections,
    .firefly,
    .ripple,
    .drop,
    .bird,
    .wing,
    .foliage,
    .leaf {
      animation: none !important;
    }
    .rain,
    .birds,
    .ripples {
      display: none;
    }
  }
</style>
