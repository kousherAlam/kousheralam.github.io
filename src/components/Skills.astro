---
import { AppConfig } from "@/utils/AppConfig";
---

<>
  <div class="mt-10">
    <h4 class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-orange-400/90">
      Skills
    </h4>
    <p class="flex flex-wrap justify-center gap-2.5 sm:justify-start items-center">
      {
        AppConfig.skills.map((skill) => (
          <span class="rounded-lg border border-slate-600 px-3 py-1.5 text-xs text-slate-300 transition-colors hover:border-orange-600 hover:text-orange-400">
            {skill}
          </span>
        ))
      }
    </p>
  </div>
</>
