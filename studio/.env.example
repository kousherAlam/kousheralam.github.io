# ---- Repo the Studio publishes to ----
REPO_OWNER=kousherAlam
REPO_NAME=kousheralam.github.io
REPO_BRANCH=master
# Path (inside the repo) where article MDX files live.
CONTENT_DIR=src/content/articles

# ---- Who is allowed to log in (comma-separated GitHub logins) ----
ALLOWED_GITHUB_LOGINS=kousherAlam

# ---- GitHub App: OAuth (login) ----
# Create a GitHub App, enable "Request user authorization (OAuth) during installation",
# and set the callback URL to <your-studio-url>/api/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- GitHub App: installation (repo writes) ----
# From the same GitHub App: App ID, the generated private key (PEM), and the
# installation id (Settings -> Install App -> the number in the URL).
GITHUB_APP_ID=
# Paste the PEM with literal \n between lines, OR base64-encode it (recommended).
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# ---- Session signing secret (any long random string) ----
# e.g. `openssl rand -hex 32`
SESSION_SECRET=

# ---- Public base URL of this Studio deployment (used to build the OAuth callback) ----
# Locally: http://localhost:4321  |  On Vercel: https://<project>.vercel.app
PUBLIC_STUDIO_URL=http://localhost:4321

# ---- Local development convenience ----
# When "true" AND OAuth is not configured, the Studio skips login and reads/writes
# article files from the local filesystem (../src/content/articles) instead of GitHub.
# NEVER set this to true in production.
STUDIO_DEV=true
