---
import Studio from '@/layouts/Studio.astro';
import { readSession, isAllowed } from '@/lib/auth';
import { oauthConfigured, localMode } from '@/lib/config';

export const prerender = false;

// Already signed in? Go home.
const session = await readSession(Astro.cookies);
if (session && isAllowed(session.login)) {
  return Astro.redirect('/');
}

const error = Astro.url.searchParams.get('error');
const canLogin = oauthConfigured();
const dev = localMode();
---

<Studio title="Sign in">
  <div class="mx-auto mt-16 max-w-md rounded-xl border border-slate-800 bg-slate-950/50 p-8 text-center">
    <h1 class="mb-2 text-2xl font-semibold text-orange-400">kousheralam studio</h1>
    <p class="mb-6 text-sm text-slate-400">
      Sign in with GitHub to write and publish posts.
    </p>

    {
      error === 'forbidden' && (
        <p class="mb-4 rounded-md bg-red-950/60 px-3 py-2 text-sm text-red-300">
          That GitHub account is not allowed to use this studio.
        </p>
      )
    }

    {
      error === 'state' && (
        <p class="mb-4 rounded-md bg-amber-950/60 px-3 py-2 text-sm text-amber-300">
          Your sign-in link expired or started on a different address. Please sign in again
          on this page.
        </p>
      )
    }

    {
      dev && (
        <a
          href="/"
          class="block rounded-md bg-orange-500 px-4 py-2.5 font-medium text-slate-950 hover:bg-orange-400"
        >
          Enter (local dev mode)
        </a>
      )
    }

    {
      !dev && canLogin && (
        <a
          href="/api/auth/login"
          class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-slate-100 px-4 py-2.5 font-medium text-slate-900 hover:bg-white"
        >
          <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z" />
          </svg>
          Sign in with GitHub
        </a>
      )
    }

    {
      !dev && !canLogin && (
        <p class="rounded-md bg-slate-800 px-3 py-2 text-sm text-slate-300">
          GitHub OAuth is not configured. Set <code>GITHUB_OAUTH_CLIENT_ID</code> and
          <code>GITHUB_OAUTH_CLIENT_SECRET</code>, or run with <code>STUDIO_DEV=true</code>.
        </p>
      )
    }
  </div>
</Studio>
